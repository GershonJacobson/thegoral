RewriteEngine On
RewriteBase /

# No directory listings
Options -Indexes

# Redirect to HTTPS (skip on localhost)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve /page as page.php when the file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [NC,L]

# Everything else is a campaign slug -> campaign.php?campaign=<slug>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*?)/?$ campaign.php?campaign=$1 [L,QSA]

ErrorDocument 404 /404.php
ErrorDocument 403 /403.php

# Block direct access to source/data/secret files and folders
RedirectMatch 404 ^/(\.git|database|logs|config|PHPMailer)(/|$)
# NB: no "json" here — the Lottie animations in /assets/animation are .json
<FilesMatch "\.(sql|log|md|sh|ini|yml|yaml|lock|docx)$">
	Require all denied
</FilesMatch>
<FilesMatch "^(db\.local\.php|db\.php|session\.php|email-config\.php|decrypt\.php|Database\.php|Validator\.php|dev-router\.php)$">
	Require all denied
</FilesMatch>

# Security response headers
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set X-Frame-Options "DENY"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Harden the session cookie (Apache + mod_php). On PHP-FPM hosts set the same
# three values in php.ini / cPanel MultiPHP INI Editor instead.
<IfModule mod_php.c>
	php_value session.cookie_httponly 1
	php_value session.cookie_samesite "Lax"
	php_value session.cookie_secure 1
	php_flag display_errors Off
</IfModule>
